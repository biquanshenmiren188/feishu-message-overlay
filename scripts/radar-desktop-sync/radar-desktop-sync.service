[Unit]
Description=Sync the latest official desktop release to the signed radar feed
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/radar-desktop-sync/sync.py
TimeoutStartSec=12min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radar-desktop-updates
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
