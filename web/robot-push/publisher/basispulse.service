[Unit]
Description=BasisPulse read-only opportunity mirror
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=robot-push
Group=robot-push
ExecStart=/usr/bin/python3 /opt/robot-push/basispulse.py
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/robot-push
MemoryMax=96M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
