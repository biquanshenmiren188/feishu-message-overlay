<Window x:Class="Overlay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="飞书消息" Width="360" Height="460" MinWidth="300" MinHeight="240" ShowInTaskbar="False" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#202020" FontFamily="Microsoft YaHei UI" FontSize="14" Closing="OnClosing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#414141" BorderThickness="1" CornerRadius="8"><Grid x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Grid Background="Transparent" ><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="飞书消息" Foreground="#F3F3F3" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold"/>
   <CheckBox shell:WindowChrome.IsHitTestVisibleInChrome="True" x:Name="Pin" Grid.Column="1" Content="置顶" ToolTip="保持窗口置顶" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="4" Click="PreferenceChanged"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border Background="#353535" Padding="6" CornerRadius="4"><TextBlock x:Name="PinText" Text="置顶" Foreground="#B8B8B8"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="PinText" Property="Foreground" Value="#60CDFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox>
   <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Content="×" Width="32" Height="32" MinHeight="32" Padding="0" Margin="4" ToolTip="隐藏到右下角托盘；监听继续" Click="HideClick"/>
  </Grid>
  <Grid Grid.Row="1" Margin="12,0,12,8">
   <TextBlock x:Name="EmptyHint" Text="尚未连接飞书&#10;在设置中完成接入后显示机器人新消息。" TextWrapping="Wrap" Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <ListBox x:Name="MessageList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True">
    <ListBox.ItemTemplate><DataTemplate><Border Background="#2B2B2B" Padding="10" Margin="0,0,0,6" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Sender}" ToolTip="{Binding Sender}" Foreground="#F3F3F3" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding SentAt, StringFormat={}{0:HH:mm:ss}}" FontSize="12" Foreground="#B8B8B8" Margin="8,0,0,0"/></Grid><TextBlock Text="{Binding Text}" Foreground="#F3F3F3" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Grid Grid.Row="2" Background="#2B2B2B"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="未连接" Foreground="#B8B8B8" FontSize="12" Margin="12,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/><Button Grid.Column="1" Content="⚙" MinHeight="28" Padding="0" Margin="0" ToolTip="设置" Click="SettingsClick"/></Grid>
  <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="16">
   <TextBlock Text="连接与运行" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><Button Content="连接飞书" Click="ConnectClick"/><Button Content="已有扫码应用" Click="LoadSavedClick"/><Button Content="扫码创建应用" Click="RegistrationClick"/></WrapPanel>
   <WrapPanel><Button Content="模拟演示" Click="DemoClick"/><Button Content="暂停" Click="PauseClick"/><Button Content="清空" Click="ClearClick"/></WrapPanel>
   <CheckBox x:Name="Sound" Content="声音提醒（跟随系统音量）" Margin="0,8" Click="PreferenceChanged"/><WrapPanel><Button Content="导入本地音频" Click="ImportAudioClick"/><Button Content="系统提示音" Click="ResetAudioClick"/><Button Content="试听" Click="SoundClick"/></WrapPanel>
   <TextBlock x:Name="AudioLabel" Text="系统提示音" FontSize="12" TextTrimming="CharacterEllipsis"/>
   <CheckBox x:Name="Autostart" Content="开机自动启动（默认关闭）" Margin="0,12" Click="StartupClick"/>
   <TextBlock Text="消息字体"/><ComboBox x:Name="FontChoice" Margin="0,4,0,8" SelectionChanged="FontChanged" AutomationProperties.Name="消息字体"/>
   <TextBlock Text="字号"/><Slider x:Name="FontScale" Minimum="12" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SizeChangedHandler" AutomationProperties.Name="字号"/>
   <TextBlock x:Name="OpacityLabel" Text="透明度 96%" Margin="0,12,0,0"/><Slider x:Name="OpacityScale" Minimum="60" Maximum="100" Value="96" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" AutomationProperties.Name="透明度"/>
   <TextBlock Text="透明度同时影响文字；设置窗口始终不透明。" FontSize="12" TextWrapping="Wrap"/><Button Content="移到右上角" Click="PositionClick" Margin="0,12,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
