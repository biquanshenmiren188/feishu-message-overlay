<Window x:Class="Overlay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Overlay.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="飞书消息小窗" Width="360" Height="460" MinWidth="300" MinHeight="120" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" Background="#FFFFFF" Foreground="#111111" FontFamily="Microsoft YaHei" FontSize="14" Closing="OnClosing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="4"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="CardButton" TargetType="Button"><Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="6,2"/><Setter Property="Foreground" Value="#222222"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Tile" Background="Transparent" BorderBrush="#C7C7C7" BorderThickness="0.7" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EEEEEE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#888888"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <local:MessageLineConverter x:Key="MessageLine"/><local:TimeFontScale x:Key="TimeFont"/><local:MessageTime x:Key="MessageTime"/><local:BodyLineHeight x:Key="BodyLineHeight"/>
  <Style x:Key="ReadingSwitch" TargetType="CheckBox"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="26"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="#B5B5B5"><Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#1677FF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#111111"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#111111"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#111111"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><Border BorderBrush="#777777" BorderThickness="1" Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="Mark" Stroke="#07C983" StrokeThickness="1.5" Data="M 2,6 L 5,9 11,3" Visibility="Collapsed"/></Border><TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/><Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="Transparent"/></Style></Grid.Style></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#111111"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="MinHeight" Value="30"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Tile" Background="#F0F0F0" CornerRadius="4" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#E0E0E0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Hit" Background="Transparent" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#EBEBEB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="IconToggle" TargetType="CheckBox"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#777777"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Hit" Background="Transparent" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#07C983"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#EBEBEB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SlimScroll" TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="26" Width="12" Background="Transparent"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#777777" CornerRadius="2" Width="4" HorizontalAlignment="Right" Margin="0,0,1,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#999999"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#AAAAAA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="WindowFrame" BorderBrush="#D8D8D8" BorderThickness="0.5" CornerRadius="4"><Grid x:Name="Root"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CardsColumn" Width="0"/><ColumnDefinition x:Name="MessagesColumn" Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="MessageBackdrop" Grid.Column="1" Grid.RowSpan="3" IsHitTestVisible="False"/>
  <Grid Background="Transparent" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center">
    <CheckBox x:Name="AutoScroll" Style="{StaticResource ReadingSwitch}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="AutoScrollClick" ToolTip="自动逐条停留；手动滚动关闭，重新打开恢复" AutomationProperties.Name="自动逐条停留"/>

    <Button x:Name="DwellButton" Style="{StaticResource IconButton}" Width="34" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="DwellClick" ToolTip="每条停留秒数（1–300）"><TextBlock x:Name="DwellLabel" Text="15s" FontSize="11"/></Button>
    <Popup x:Name="DwellPopup" PlacementTarget="{Binding ElementName=DwellButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#D8D8D8" BorderThickness="1" Padding="6"><StackPanel Orientation="Horizontal"><TextBox x:Name="DwellInput" Width="42" Text="15" PreviewKeyDown="DwellKey"/><TextBlock Text=" 秒" VerticalAlignment="Center"/><Button Content="确定" Click="DwellCommit" Margin="6,0,0,0"/></StackPanel></Border></Popup>
    <Button Style="{StaticResource IconButton}" Width="24" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="HomeClick" ToolTip="归位右上角 · 铺满桌面高度" AutomationProperties.Name="归位右上角"><Path Stroke="#686868" StrokeThickness="1.1" Data="M 1,5 L 7,1 13,5 M 3,4 L 3,13 11,13 11,4 M 8,8 L 12,8 12,12"/></Button>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,3,0"><StackPanel Orientation="Horizontal" Width="13" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding Text, ElementName=Status}"><Rectangle x:Name="State1" Width="3" Height="4" VerticalAlignment="Bottom" RadiusX="0.5" RadiusY="0.5" Fill="#777777" Margin="0,0,2,0"/><Rectangle x:Name="State2" Width="3" Height="8" VerticalAlignment="Bottom" RadiusX="0.5" RadiusY="0.5" Fill="#777777" Margin="0,0,2,0"/><Rectangle x:Name="State3" Width="3" Height="12" VerticalAlignment="Bottom" RadiusX="0.5" RadiusY="0.5" Fill="#777777"/></StackPanel>
    <CheckBox x:Name="Sound" Style="{StaticResource IconToggle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="PreferenceChanged" ToolTip="声音开关 · 跟随系统音量" AutomationProperties.Name="声音开关"><Grid><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.2" Data="M 1,5 L 4,5 8,1 8,13 4,9 1,9 Z"/><Path x:Name="SoundWaves" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.2" Data="M 11,4 Q 14,7 11,10 M 13,1 Q 19,7 13,13"/></Grid></CheckBox>
    <CheckBox x:Name="Pin" Style="{StaticResource IconToggle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="PreferenceChanged" ToolTip="置顶" AutomationProperties.Name="置顶"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.1" Data="M 3,1 L 11,1 9,6 12,11 2,11 5,6 Z M 7,11 L 7,17"/></CheckBox>
    <Button Style="{StaticResource IconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="设置" AutomationProperties.Name="设置" Click="SettingsClick"><Path Stroke="#686868" StrokeThickness="1.15" Data="M 6,0 L 10,0 10,3 13,4 15,2 18,5 16,7 17,10 20,10 20,14 17,14 16,17 18,19 15,22 13,20 10,21 10,24 6,24 6,21 3,20 1,22 -2,19 0,17 -1,14 -4,14 -4,10 -1,10 0,7 -2,5 1,2 3,4 6,3 Z M 8,7 A 5,5 0 1 0 8,17 A 5,5 0 1 0 8,7" Stretch="Uniform" Width="14" Height="14"/></Button>
    <Button Style="{StaticResource IconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘" Click="HideClick"><Path Stroke="#686868" StrokeThickness="1.2" Data="M 1,1 L 11,11 M 11,1 L 1,11"/></Button>
   </StackPanel>
  </Grid>
  <Border x:Name="OpportunityArea" shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" BorderThickness="0" Background="{x:Null}"/>
  <ScrollViewer x:Name="PinnedArea" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Margin="7,0,3,4" MaxHeight="240" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="PinnedCard" ContentTemplate="{Binding ItemTemplate,ElementName=MessageList}" FontFamily="{Binding FontFamily,ElementName=MessageList}" FontSize="{Binding FontSize,ElementName=MessageList}"/></ScrollViewer>
  <Grid x:Name="MessageArea" Grid.Column="1" Grid.Row="2" Margin="7,0,3,6" MouseMove="MessageMouseMove" PreviewMouseWheel="MessageWheel" PreviewKeyDown="MessageKey">
   <TextBlock x:Name="EmptyHint" Text="暂无新消息" Foreground="#969696" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <ListBox x:Name="MessageList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5">
    <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_MessageScroll" CanContentScroll="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MessageScrolled" Focusable="True" Margin="0"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><local:MessageView Message="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   <ScrollBar x:Name="MessageBar" Style="{StaticResource SlimScroll}" HorizontalAlignment="Right" VerticalAlignment="Stretch" Orientation="Vertical" Minimum="0"  ValueChanged="BarChanged" Opacity="0" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="16">
   <TextBlock Foreground="#111111" x:Name="Status" Text="未连接" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <CheckBox x:Name="SettingsReading" Content="自动逐条停留（手动滚动暂停）" Click="AutoScrollClick" Margin="0,0,0,12"/>
   <TextBlock Foreground="#111111" Text="连接与运行" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><Button Content="连接飞书" Click="ConnectClick"/><Button Content="已有扫码应用" Click="LoadSavedClick"/><Button Content="扫码创建应用" Click="RegistrationClick"/></WrapPanel>
   <WrapPanel><Button Content="模拟演示" Click="DemoClick"/><Button Content="暂停" Click="PauseClick"/><Button Content="清空" Click="ClearClick"/></WrapPanel>
   <CheckBox x:Name="SettingsSound" IsChecked="{Binding IsChecked, ElementName=Sound, Mode=TwoWay}" Content="声音提醒（跟随系统音量）" Margin="0,8" Click="PreferenceChanged"/><WrapPanel><Button Content="导入本地音频" Click="ImportAudioClick"/><Button Content="默认提示音" Click="ResetAudioClick"/><Button Content="试听" Click="SoundClick"/></WrapPanel>
   <TextBlock Foreground="#111111" x:Name="AudioLabel" Text="系统提示音" FontSize="12" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="置顶群（顶部固定最新一条，下方连续显示消息）" TextWrapping="Wrap" Margin="0,8,0,4"/>
   <ComboBox x:Name="PinnedGroup" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="PinnedGroupChanged"/>
   <TextBlock x:Name="PinnedStatus" FontSize="12" Foreground="#777777" TextWrapping="Wrap" Margin="0,4,0,8"/>
   <CheckBox x:Name="AutoJoined" Content="自动监听本机器人已加入群的机器人新消息" Click="AutoJoinedClick" Margin="0,8"/>
    <CheckBox x:Name="Autostart" Content="开机自动启动（随Windows登录启动）" Margin="0,12" Click="StartupClick"/>
   <TextBlock Foreground="#111111" Text="消息字体"/><ComboBox x:Name="FontChoice" Margin="0,4,0,8" SelectionChanged="FontChanged" AutomationProperties.Name="消息字体" Foreground="#111111"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Source}" Foreground="#111111"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <TextBlock Foreground="#111111" Text="字号"/><Slider x:Name="FontScale" Minimum="12" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SizeChangedHandler" AutomationProperties.Name="字号"/>
   <TextBlock Foreground="#111111" x:Name="OpacityLabel" Text="背景透明度 96%" Margin="0,12,0,0"/><Slider x:Name="OpacityScale" Minimum="60" Maximum="100" Value="96" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" AutomationProperties.Name="背景透明度"/>
   <TextBlock Foreground="#111111" Text="仅白色背景半透明，文字保持清晰；建议 95%。" FontSize="12" TextWrapping="Wrap"/><Button Content="移到右上角" Click="PositionClick" Margin="0,12,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
