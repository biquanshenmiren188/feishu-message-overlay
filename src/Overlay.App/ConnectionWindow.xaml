<Window x:Class="Overlay.App.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="飞书官方连接 · 本次会话" Width="580" Height="740" MinWidth="420" MinHeight="480" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="14">
 <DockPanel Margin="20"><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="连接（仅本次，不保存密钥）" Click="SubmitClick"/><Button Content="取消" Click="CloseClick" IsCancel="True"/></WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="连接指定群的机器人消息" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock TextWrapping="Wrap" Text="请使用已获批准的专用企业应用。网页登录不等于消息授权；连接会将应用凭证交给飞书官方服务，消息只在本机展示。" Margin="0,0,0,12"/>
   <TextBlock Text="App ID"/><TextBox x:Name="AppIdInput" AutomationProperties.Name="App ID" Margin="0,4,0,12"/>
   <TextBlock x:Name="SecretHint" Text="App Secret（本机输入，不要发送到聊天）"/><PasswordBox x:Name="SecretInput" AutomationProperties.Name="App Secret" Margin="0,4,0,12"/>
   <Button Content="使用已由本人批准保存的本机应用凭证" Click="LoadSavedClick" HorizontalAlignment="Left"/>
   <TextBlock Text="核验后的群 chat_id · 一至五个，每行一个"/><TextBox x:Name="ChatInput" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="指定群 ID" Margin="0,4,0,12"/>
   <TextBlock Text="机器人 open_id · 可选，每行一个"/><TextBox x:Name="BotInput" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="机器人 ID 筛选" Margin="0,4,0,4"/>
   <TextBlock TextWrapping="Wrap" Text="留空表示接收选定群中所有机器人；普通成员消息始终不显示、不提醒。身份以官方 sender_type=bot 和 ID 判断。" Margin="0,0,0,12"/>
   <CheckBox x:Name="Consent" Content="我确认应用已获准访问这些群，并同意本次连接" Margin="0,0,0,12"/>
   <TextBlock x:Name="Validation" Foreground="#B91C1C" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,12"/>
   <Expander Header="所需官方设置与隐私说明"><StackPanel Margin="0,8,0,0">
    <TextBlock TextWrapping="Wrap" Text="专用应用开启机器人能力，申请 im:message.group_msg.include_bot:read，订阅 im.message.receive_v1，选择长连接并发布获批准版本。监听机器人仅加入选定群。租户可能要求管理员审批；实际消息覆盖须逐群验收。" Margin="0,0,0,12"/>
    <TextBlock TextWrapping="Wrap" Text="应用 ID、密钥、群和机器人 ID 均不保存。凭证仅在本次进程内存及私有进程管道中使用，不进入命令行、日志或 GitHub。消息最多100条/30分钟；卡片仅展示实际可读取文字，不读取图片附件。暂停后请重新连接；重连只接收恢复后的新消息。"/>
   </StackPanel></Expander>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
